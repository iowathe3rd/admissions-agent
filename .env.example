# 🔑 Конфигурация для Admissions Agent
# Скопируйте этот файл в .env и заполните своими ключами

# ========================================
# ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ
# ========================================

# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (получить на https://makersuite.google.com/app/apikey)  
# Используйте только GEMINI_API_KEY ИЛИ GOOGLE_CREDENTIALS_PATH, не оба
GEMINI_API_KEY=your_google_gemini_api_key_here

# Альтернативно: путь к JSON файлу с credentials для Google Cloud (если используется сервисный аккаунт)
# GOOGLE_CREDENTIALS_PATH=.secrets/google-credentials.json

# Настройки для Vertex AI (требуются при использовании JSON credentials)
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ========================================
# ОПЦИОНАЛЬНЫЕ НАСТРОЙКИ RAG
# ========================================

# Порог релевантности для поиска (0.0 - 1.0, чем выше - тем строже)
RAG_RELEVANCE_THRESHOLD=0.75

# Количество документов для контекста (1-10)
RAG_TOP_K=5

# ========================================
# ПРИМЕР ЗАПОЛНЕННОГО ФАЙЛА:
# ========================================
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# GEMINI_API_KEY=AIzaSyD1234567890abcdefghijklmnopqrstuvwx
